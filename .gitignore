# API keys and secrets
.env
.env~

# onyx-cli settings
# We want to keep the .onyx in the root of the repo and ignore any .onyx
# in subdirectories. In our root .onyx we want to allow for version control
# for subcommands.
**/.onyx/
!/.onyx/
.onyx/*
!.onyx/config.yaml
!.onyx/commands/
!.onyx/skills/
!.onyx/settings.json

# Note: .onyx-clipboard/ is NOT in gitignore so Onyx can access pasted images

# Dependency directory
node_modules
bower_components

# Editors
.idea
*.iml

# OS metadata
.DS_Store
Thumbs.db

# TypeScript build info files
*.tsbuildinfo

# Ignore built ts files
dist

# Docker folder to help skip auth refreshes
.docker

bundle

# Test report files
junit.xml
packages/*/coverage/

# Generated files
packages/cli/src/generated/
packages/core/src/generated/
packages/devtools/src/_client-assets.ts
.integration-tests/
.perf-tests/
packages/vscode-ide-companion/*.vsix
packages/cli/download-ripgrep*/

# GHA credentials
gha-creds-*.json

# Log files
patch_output.log
onyx-debug.log

.genkit
.onyx-clipboard/
.eslintcache
evals/logs/

temp_agents/

# conductor extension and planning directories
conductor/
packages/core/src/sandbox/windows/OnyxSandbox.exe
